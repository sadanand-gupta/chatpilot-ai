# ─────────────────────────────────────────────────────────────────────────────
# ChatPilot AI — environment reference (ALL variables, safe placeholders only)
#
# This root file is documentation. Each app reads its own file:
#   API     → apps/api/.env.development   (copy apps/api/.env.development.example)
#   Web     → apps/web/.env.development   (Vite: only VITE_* reach the browser)
#   Widget  → build-time env when running `npm run build -w @chatpilot/widget`
# In production set these on the host (Render / Vercel / Cloudflare / Firebase).
# NEVER commit real values. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Numeric values below are examples; if unset the API uses its own defaults.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════ API (apps/api) ═══════════════════════════════

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # production on the server
PORT=8787                            # Render injects PORT automatically
TRUST_PROXY=1                        # number of proxy hops (Render/Cloud Run: 1). Needed for correct client IPs in rate limits
PRODUCT_NAME=ChatPilot AI

# --- Public URLs (no trailing slash) ----------------------------------------
FRONTEND_URLS=http://localhost:5173  # comma-separated dashboard origins allowed by CORS for PRIVATE routes
PUBLIC_APP_URL=http://localhost:5173 # dashboard / hosted chat page base (https://app.example.com)
PUBLIC_API_URL=http://localhost:8787 # this API's public base (https://api.example.com)
PUBLIC_WIDGET_URL=http://localhost:8787/widget.js  # URL used in generated embed snippets (API-served or CDN)
WIDGET_DIST_DIR=../widget/dist       # where the API finds widget.js to serve at /widget.js (relative to apps/api)

# --- Auth --------------------------------------------------------------------
# firebase = verify Firebase ID tokens (production). dev = local JWT via POST /api/dev/login.
# The API REFUSES TO START with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-dev-only-at-least-32-characters-long

# --- Data store -------------------------------------------------------------
# firestore (production) | file (local JSON store, dev/test only — refused in production)
DATA_STORE=file
FILE_STORE_DIR=.data                 # relative to apps/api

# --- Firebase Admin (required when AUTH_MODE=firebase or DATA_STORE=firestore) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON on ONE line with literal \n
# (the API replaces "\n" with newlines). Keep the surrounding quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Alternative to the three vars above: path to the JSON key file (never commit it).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service-account.json

# --- AI provider ------------------------------------------------------------
# openai = any OpenAI-compatible /chat/completions API (OpenAI, Groq, OpenRouter, Together,
#          Gemini's OpenAI-compatible endpoint, Cloudflare Workers AI, ...)
# ollama = local dev only.  mock = deterministic fake replies (dev/test; refused in production).
# See docs/AI_PROVIDERS.md for verified base URLs, models, free tiers and costs.
AI_PROVIDER=mock
# Recommended launch default (PAID tier — the free tier may use prompts for training):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=replace-with-provider-key
AI_MODEL=gemini-2.5-flash-lite
# Fallback: Groq  AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=4                 # simultaneous upstream calls per instance
MAX_OUTPUT_TOKENS=400
AI_TEMPERATURE=0.3
# Ollama example (local only):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.2:3b

# --- Crawler ----------------------------------------------------------------
MAX_CRAWL_PAGES=50                   # hard ceiling; plan pagesPerCrawl applies below this
MAX_CRAWL_DEPTH=3
CRAWL_CONCURRENCY=3
CRAWL_PAGE_TIMEOUT_MS=15000
CRAWL_MAX_PAGE_BYTES=2000000

# --- Chat & abuse limits ----------------------------------------------------
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120          # per IP per window, all routes (in-memory, per instance)
PUBLIC_CHAT_RATE_LIMIT=20            # per IP per window on public chat/lead routes
CONVERSATION_SECRET=change-me-hmac-secret-at-least-32-characters   # signs conversation tokens

# --- Landing-page live demo -------------------------------------------------
DEMO_ENABLED=true
DEMO_MAX_PAGES=10
DEMO_MAX_MESSAGES=10                 # per demo bot
DEMO_PER_IP_PER_HOUR=3

# --- Plans & admin ----------------------------------------------------------
# Optional JSON array overriding packages/shared DEFAULT_PLANS (see docs/MONETIZATION.md).
# PLANS_JSON=[{"id":"free","name":"Free Trial",...}]
PLANS_JSON=
ADMIN_TOKEN=change-me-admin-token-at-least-32-characters   # protects admin-only endpoints; leave empty to disable them

# --- Misc -------------------------------------------------------------------
# Optional screenshot service for Preview Studio; "{url}" is replaced by the encoded site URL.
# Leave empty to use the SiteMeta mockup fallback.
SCREENSHOT_URL_TEMPLATE=


# ═════════════════════════════ WEB (apps/web, Vite) ══════════════════════════
# Everything here is PUBLIC (bundled into the browser). Never put secrets in VITE_*.
VITE_API_URL=http://localhost:8787
VITE_WIDGET_URL=http://localhost:8787/widget.js
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_PRODUCT_NAME=ChatPilot AI
VITE_AUTH_MODE=dev                   # dev | firebase (production must be firebase)
# Firebase web app config (Project settings → Your apps → Web). Public by design;
# security comes from Auth + deny-all Firestore rules + server-side checks.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_LANDING_CHATBOT_ID=             # publicId of your own published bot shown on the landing page (optional)
VITE_CONTACT_EMAIL=hello@example.com


# ═════════════════════════════ WIDGET build (apps/widget) ════════════════════
WIDGET_DEFAULT_API_URL=http://localhost:8787   # used when the snippet has no data-api-url
WIDGET_PRODUCT_NAME=ChatPilot AI              # "Powered by ..." label (falls back to PRODUCT_NAME)
WIDGET_PRODUCT_URL=http://localhost:5173       # "Powered by" link target (falls back to PRODUCT_URL) — set to your public app URL in production


# ═════════════════════════════ E2E (Playwright) ══════════════════════════════
# E2E_SITE_URL=https://example.com
# E2E_API_URL=http://localhost:8787
# E2E_WEB_URL=http://localhost:5173
# E2E_NO_SERVER=1
