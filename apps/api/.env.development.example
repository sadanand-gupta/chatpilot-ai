# ChatPilot API — LOCAL DEVELOPMENT ONLY. Copy to apps/api/.env.development.
# These values are intentionally insecure placeholders; the API refuses to start
# with AUTH_MODE=dev, DATA_STORE=file, AI_PROVIDER=mock or placeholder secrets
# when NODE_ENV=production.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Public URLs (no trailing slash)
FRONTEND_URLS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
PUBLIC_WIDGET_URL=http://localhost:8787/widget.js
# WIDGET_DIST_DIR=../widget/dist

# Auth: dev = POST /api/dev/login {email} returns a local JWT (no Firebase needed)
AUTH_MODE=dev
DEV_JWT_SECRET=dev-only-secret-change-me

# Data: JSON file store under apps/api/.data (dev/test only)
DATA_STORE=file
FILE_STORE_DIR=.data

# AI: mock replies are prefixed "[dev mock AI]". For a real model use e.g.
#   AI_PROVIDER=openai  AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=openai/gpt-oss-20b  AI_API_KEY=...
#   (reasoning models such as gpt-oss need MAX_OUTPUT_TOKENS=800 or more)
#   AI_PROVIDER=ollama  AI_BASE_URL=http://localhost:11434  AI_MODEL=llama3.2:3b
AI_PROVIDER=mock
MAX_OUTPUT_TOKENS=500
AI_TEMPERATURE=0.2

# Crawler
MAX_CRAWL_PAGES=50
MAX_CRAWL_DEPTH=3
CRAWL_CONCURRENCY=3
CRAWL_PAGE_TIMEOUT_MS=12000

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
PRIVATE_RATE_LIMIT_PER_USER=600
PUBLIC_CHAT_RATE_LIMIT=20
LEADS_RATE_LIMIT=5
CRAWL_START_RATE_LIMIT=10

# Demo
DEMO_ENABLED=true
DEMO_MAX_PAGES=8
DEMO_MAX_MESSAGES=15
DEMO_PER_IP_PER_HOUR=20
DEMO_GLOBAL_PER_HOUR=100
DEMO_GLOBAL_MESSAGES_PER_DAY=1000

# Secrets (dev placeholders — generate real ones for production)
CONVERSATION_SECRET=dev-conversation-secret
ADMIN_TOKEN=dev-admin-token

# Optional
# SCREENSHOT_URL_TEMPLATE=https://image.thum.io/get/width/1200/{url}
# PLANS_JSON=[{"id":"free","limits":{"messagesPerMonth":200}}]
# CLEANUP_INTERVAL_MS=3600000
TRUST_PROXY=1
PRODUCT_NAME=ChatPilot AI
