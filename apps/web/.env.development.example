# Copy to .env.development (or .env.local) and adjust.
VITE_API_URL=http://localhost:8787
VITE_AUTH_MODE=dev
VITE_WIDGET_URL=http://localhost:8787/widget.js
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_PRODUCT_NAME=ChatPilot AI
VITE_CONTACT_EMAIL=hello@example.com

# Firebase Web SDK (required when VITE_AUTH_MODE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: publicId of a published ChatPilot bot to load on the landing page (dogfooding).
VITE_LANDING_CHATBOT_ID=
